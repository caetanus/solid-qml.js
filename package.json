{
  "name": "solid-qml-native",
  "private": true,
  "version": "0.2.0",
  "license": "UNLICENSED",
  "type": "module",
  "security": {
    "postinstall": "disabled",
    "npmLifecycleScripts": "ignored via .npmrc"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "qmldev": "vite --mode qmldev",
    "build": "vite build",
    "test": "npm run typecheck && npm run test:transpiler",
    "test:transpiler": "node --import tsx --test transpiler/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p transpiler/tsconfig.json --noEmit",
    "typecheck:transpiler": "tsc -p transpiler/tsconfig.json --noEmit",
    "dev:native": "node --import tsx scripts/dev-native.mjs",
    "gen:cpp": "node --import tsx scripts/gen-cpp.mjs",
    "twin-render": "node --import tsx scripts/twin-render.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "js-base64": "^3.8.0",
    "solid-js": "^1.9.10",
    "vite": "^7.2.7",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@types/node": "^26.1.1",
    "babel-plugin-transform-async-to-promises": "^0.8.18",
    "core-js": "^3.49.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.8"
  }
}
