{
  "name": "solid-qml-monorepo",
  "private": true,
  "version": "0.3.0-preview.1",
  "description": "Solid.js, rendered natively via QML/QtQuick — no browser.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/solid-qml",
    "packages/create-solid-qml",
    "packages/runtime-linux-x64"
  ],
  "security": {
    "postinstall": "disabled",
    "npmLifecycleScripts": "ignored via .npmrc"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "qmldev": "vite --mode qmldev",
    "build": "vite build",
    "test": "npm run typecheck && npm run test:transpiler && npm run check:version",
    "test:transpiler": "node --import tsx --test transpiler/test/*.test.ts",
    "check:version": "node scripts/check-version-consistency.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p transpiler/tsconfig.json --noEmit",
    "typecheck:transpiler": "tsc -p transpiler/tsconfig.json --noEmit",
    "dev:native": "node --import tsx scripts/dev-native.mjs",
    "gen:cpp": "node --import tsx scripts/gen-cpp.mjs",
    "twin-render": "node --import tsx scripts/twin-render.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "bench": "node --import tsx scripts/bench-aot.mjs",
    "sdk:build": "node scripts/sdk/build-packages.mjs",
    "sdk:pack": "node scripts/sdk/pack.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "js-base64": "^3.8.0",
    "solid-js": "^1.9.10",
    "vite": "^7.2.7",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@types/node": "^26.1.1",
    "babel-plugin-transform-async-to-promises": "^0.8.18",
    "core-js": "^3.49.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite-plugin-solid": "^2.11.8"
  }
}
