{
  "name": "solid-qml",
  "version": "0.3.0-preview.1",
  "description": "Solid.js apps rendered natively with Qt Quick — CLI (create/dev/build/doctor), Vite plugin, transpiler and authoring runtime.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caetanus/solid-qml.js.git",
    "directory": "packages/solid-qml"
  },
  "keywords": [
    "solid",
    "solid-js",
    "qml",
    "qt",
    "qtquick",
    "native",
    "desktop",
    "vite"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "solid-qml": "./bin/solid-qml.mjs"
  },
  "exports": {
    ".": {
      "types": "./runtime/index.tsx",
      "default": "./runtime/index.tsx"
    },
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    },
    "./transpiler": "./dist/transpiler.mjs",
    "./jsx": {
      "types": "./runtime/jsx.d.ts"
    },
    "./reset.css": "./runtime/reset.css",
    "./base.css": "./runtime/base.css",
    "./themes/*": "./runtime/themes/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/",
    "assets/",
    "dist/",
    "runtime/",
    "vite.mjs",
    "vite.d.mts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "babel-plugin-transform-async-to-promises": "^0.8.18",
    "create-solid-qml": "0.3.0-preview.1"
  },
  "optionalDependencies": {
    "@solid-qml/runtime-linux-x64": "0.3.0-preview.1"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
